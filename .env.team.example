# Team onboarding: copy to .env only if it does not already exist.
# This example uses Bailian for text + web search + image generation.
# Replace the two names below with YOUR EXISTING environment variable NAMES.
# Do not paste credentials here or into frontend VITE_/NEXT_PUBLIC_ variables.
LLM_PROVIDER=bailian
BAILIAN_API_KEY_ENV=YOUR_EXISTING_KEY_VARIABLE
BAILIAN_BASE_URL_ENV=YOUR_EXISTING_ENDPOINT_VARIABLE
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_SEARCH_MODEL=qwen-plus
BAILIAN_IMAGE_MODEL=qwen-image-2.1-pro
M1_MODE=live
M2_MODE=live
M3_MODE=live
M4_MODE=live
HUB_DATA_DIR=data/group02
LLM_TIMEOUT_SECONDS=120
M5_TIMEOUT_SECONDS=120

# If your endpoint is not stored in an environment variable, remove its _ENV
# line and set BAILIAN_BASE_URL to your actual compatible-mode/v1 endpoint.
# For other compatible text providers, replace the LLM_PROVIDER/BAILIAN section
# with LLM_API_KEY_ENV + LLM_BASE_URL_ENV + LLM_MODEL (or LLM_MODEL_ENV).
# Search/image then require their own configuration; see the team guide.
