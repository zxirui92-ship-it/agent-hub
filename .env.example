# live never falls back to mock. Mock router accepts skill_name: request.
M4_MODE=live
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# All text modules and Planner: complete LLM_* override wins as a group.
# Otherwise select local DEEPSEEK_* (default) or BAILIAN_*; no credential copying.
LLM_PROVIDER=deepseek
# DEEPSEEK_MODEL defaults to deepseek-flash; BAILIAN_TEXT_MODEL to qwen-plus.
# HUB_PLANNER_MODEL overrides only the Planner model within the selected service.
HUB_PLANNER_MODEL=
# M3 runs local Plan/Execute by default; live uses the shared model without fallback.
M3_MODE=local
# M1 mock answers are labeled; M2 local decisions use the shared fixture orders.
# Neither module silently falls back when live configuration is missing.
M1_MODE=live
M2_MODE=live
MAX_REACT_ITERATIONS=3
# Optional directory with order_basic/user_behavior/marketing_campaign JSON files.
# Blank uses the existing weekly sample data in data/fixtures/m3 (not live data).
M6_DATA_DIR=
# Shared model settings for the top-level Planner, M1, M2, M3, M4 and M5.
LLM_TIMEOUT_SECONDS=120
# M5's aggregation can take longer; one attempt per call, no implicit retry.
M5_TIMEOUT_SECONDS=120
# Domestic default: reuse BAILIAN_BASE_URL/API_KEY with native Qwen web search.
# Blank auto-selects bailian when that group is present, otherwise tavily.
M4_SEARCH_PROVIDER=
# Optional independent search model; default qwen-plus (native text-generation).
BAILIAN_SEARCH_MODEL=qwen-plus
# Any nonempty M4_SEARCH_URL/API_KEY/MODEL selects this entire override group.
# For a Bailian override, also set M4_SEARCH_PROVIDER=bailian; URL accepts the
# same compatible-mode/v1 base as BAILIAN_BASE_URL. Tavily accepts /search URL.
M4_SEARCH_URL=
M4_SEARCH_API_KEY=
M4_SEARCH_MODEL=
# OpenAI-compatible base URL including /v1; model must support images/generations.
M4_IMAGE_BASE_URL=
M4_IMAGE_API_KEY=
M4_IMAGE_MODEL=
# Blank auto-selects bailian when BAILIAN_BASE_URL/API_KEY are present and no
# M4_IMAGE_* override was supplied. Explicit choices: openai or bailian.
M4_IMAGE_PROVIDER=
M4_IMAGE_TIMEOUT_SECONDS=180
# Set BAILIAN_API_KEY and BAILIAN_BASE_URL in the local environment.
# The native image endpoint is derived from that same business-space URL.
# BAILIAN_IMAGE_MODEL defaults to qwen-image-2.0, independently of text model.
M4_SERVICE_TIMEOUT_SECONDS=60
# Optional JSON knowledge file; blank uses clearly marked bundled sample policies.
M4_KB_PATH=
LOG_LEVEL=INFO
# Tests require BOTH --run-live and M4_RUN_LIVE_TESTS=1. May incur API charges.
M4_RUN_LIVE_TESTS=0
# Planner model evaluation; business execution in these tests remains mocked.
HUB_RUN_LIVE_TESTS=0
# Business model / end-to-end tests require BOTH this flag and --run-live.
# Does not enable search/image tests; these remain under M4_RUN_LIVE_TESTS.
BUSINESS_RUN_LIVE_TESTS=0
