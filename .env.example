# live never falls back to mock. Mock router accepts skill_name: request.
M4_MODE=live
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Tavily-compatible endpoint, e.g. https://api.tavily.com/search
M4_SEARCH_URL=
M4_SEARCH_API_KEY=
# OpenAI-compatible base URL including /v1; model must support images/generations.
M4_IMAGE_BASE_URL=
M4_IMAGE_API_KEY=
M4_IMAGE_MODEL=
M4_SERVICE_TIMEOUT_SECONDS=60
# Optional JSON knowledge file; blank uses clearly marked bundled sample policies.
M4_KB_PATH=
LOG_LEVEL=INFO
# Tests require BOTH --run-live and M4_RUN_LIVE_TESTS=1. May incur API charges.
M4_RUN_LIVE_TESTS=0
